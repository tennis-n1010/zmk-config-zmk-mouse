# No whitespace after the comma or in your keyboard name!
config SHIELD_ZMK_MOUSE_STANDALONE
    def_bool $(shields_list_contains,zmk_mouse_standalone)

config SHIELD_ZMK_MOUSE_PERIPHERAL
    def_bool $(shields_list_contains,zmk_mouse_peripheral)

config SHIELD_ZMK_MOUSE_DONGLE
    def_bool $(shields_list_contains,zmk_mouse_dongle)